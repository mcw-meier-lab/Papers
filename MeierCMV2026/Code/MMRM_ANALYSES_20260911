# -------------------------------------------------- #
# 4. FUNCTION TO RUN MMRM + TABLES FOR ONE MODALITY  #
# -------------------------------------------------- #
run_mmrm_for_modality <- function(data, outcomes, label) {
  
  summaries <- data.frame()
  anova_all <- data.frame()
  joint_all <- data.frame()
  emmeans_all <- data.frame()
  emmeans_contrasts_all <- data.frame()
  cell_counts_all <- data.frame()
  
  outcome_col <- paste0(label, "_Outcome")
  
  for (out in outcomes) {
    
    cat("✔ Performing Mixed Models for Repeated Measures:", label, "-", out, "\n")
    
    f <- as.formula(paste0(out, " ~ mTBI_CMV_PI * VISIT + us(VISIT | INJURYID)"))
    
    mod <- mmrm(
      formula = f,
      data = data,
      weights = data$weights,
      method = "Residual",
      vcov = "Empirical-Bias-Reduced")
    
    # -------------------------
    # Tidy summary
    # -------------------------
    tmp_summary <- broom::tidy(mod)
    tmp_summary[[outcome_col]] <- out
    summaries <- bind_rows(summaries, tmp_summary)
    
    # -------------------------
    # ANOVA
    # -------------------------
    tmp_aov <- as.data.frame(Anova(mod, type = "III"))
    tmp_aov <- cbind(Term = rownames(tmp_aov), tmp_aov)
    rownames(tmp_aov) <- NULL
    tmp_aov[[outcome_col]] <- out
    anova_all <- bind_rows(anova_all, tmp_aov)
    
    # -------------------------
    # Joint tests
    # -------------------------
    tmp_joint <- as.data.frame(joint_tests(mod, by = "VISIT"))
    tmp_joint[[outcome_col]] <- out
    joint_all <- bind_rows(joint_all, tmp_joint)
    
    # -------------------------
    # EMMEANS
    # -------------------------
    em <- emmeans(mod, ~ mTBI_CMV_PI | VISIT)
    
    tmp_emmeans <- as.data.frame(
      summary(em)) %>% 
      mutate(
        mTBI_CMV_PI = as.character(mTBI_CMV_PI),
        !!outcome_col := out)
    
    emmeans_all <- bind_rows(emmeans_all, tmp_emmeans)
    
    # -------------------------
    # CONTRASTS (infer = TRUE)
    # -------------------------
    em_contrasts <- contrast(em, method = "pairwise", adjust = "none")
    
    tmp_contrasts <- as.data.frame(
      summary(em_contrasts, infer = TRUE))
    
    if (!"contrast" %in% names(tmp_contrasts)) {
      tmp_contrasts$contrast <- rownames(tmp_contrasts)
      rownames(tmp_contrasts) <- NULL
    }
    
    tmp_contrasts[[outcome_col]] <- out
    emmeans_contrasts_all <- bind_rows(emmeans_contrasts_all, tmp_contrasts)
    
    # -------------------------
    # CELL COUNTS
    # -------------------------
    tmp_counts <- data %>% 
      group_by(VISIT, mTBI_CMV_PI) %>% 
      summarise(
        n_non_na = sum(!is.na(.data[[out]])),
        .groups = "drop") %>% 
      mutate(
        mTBI_CMV_PI = as.character(mTBI_CMV_PI),
        !!outcome_col := out)
    cell_counts_all <- bind_rows(cell_counts_all, tmp_counts)
  }
  
  # =========================================================
  # BUILD contrasts_effects
  # =========================================================
  
  contrasts_effects <- emmeans_contrasts_all |>
    mutate(
      VISIT = as.character(VISIT),
      contrast = as.character(contrast),
      group1 = trimws(gsub("[()]", "", sub("^(.*?) - .*", "\\1", contrast))),
      group2 = trimws(gsub("[()]", "", sub(".* - (.*)$", "\\1", contrast)))) %>% 
    
    # Join emmeans group 1
    left_join(
      emmeans_all %>% 
        select(!!sym(outcome_col), VISIT, mTBI_CMV_PI, emmean, SE) |>
        rename(group = mTBI_CMV_PI,
               emmean_g1 = emmean,
               SE_g1 = SE),
      by = c(outcome_col, "VISIT", "group1" = "group")) %>% 
    
    # Join emmeans group 2
    left_join(
      emmeans_all %>% 
        select(!!sym(outcome_col), VISIT, mTBI_CMV_PI, emmean, SE) |>
        rename(group = mTBI_CMV_PI,
               emmean_g2 = emmean,
               SE_g2 = SE),
      by = c(outcome_col, "VISIT", "group2" = "group")) %>% 
    
    # Join cell counts
    left_join(
      cell_counts_all %>% 
        select(!!sym(outcome_col), VISIT, mTBI_CMV_PI, n_non_na) %>% 
        rename(group = mTBI_CMV_PI, n1 = n_non_na),
      by = c(outcome_col, "VISIT", "group1" = "group")) %>% 
    
    left_join(
      cell_counts_all %>% 
        select(!!sym(outcome_col), VISIT, mTBI_CMV_PI, n_non_na) %>% 
        rename(group = mTBI_CMV_PI, n2 = n_non_na),
      by = c(outcome_col, "VISIT", "group2" = "group")) %>% 
    
    # Rename contrast columns
    rename(
      contrast_estimate = estimate,
      contrast_p = p.value,
      contrast_lower = lower.CL,
      contrast_upper = upper.CL) %>% 
    
    # Contrast effect sizes (Cohen's d) using model-based contrast estimates & SEs but cell counts from raw data
    mutate(
      SD1 = SE_g1 * sqrt(n1),
      SD2 = SE_g2 * sqrt(n2),
      pooled_SD = sqrt(((n1 - 1) * SD1^2 + (n2 - 1) * SD2^2) /
                         (n1 + n2 - 2)),
      cohen_d = contrast_estimate / pooled_SD) %>% 
    
    select(
      VISIT,
      !!sym(outcome_col),
      group1, emmean_g1,
      group2, emmean_g2,
      contrast_estimate, contrast_p,
      contrast_lower, contrast_upper,
      n1, n2,
      pooled_SD, cohen_d)
  
  list(
    summaries = summaries,
    anova = anova_all,
    joint = joint_all,
    emmeans = emmeans_all,
    emmeans_contrasts = emmeans_contrasts_all,
    cell_counts = cell_counts_all,
    contrasts_effects = contrasts_effects)
}

