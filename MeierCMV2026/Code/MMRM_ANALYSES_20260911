# ----------------------------------------------------------- #
# 23. FIGURE PDFS – FIGURES AND DIAGNOSTIC PLOTS PER MODALITY  #
# ----------------------------------------------------------- #

plot_modality <- function(data, outcomes, label, pdf_file) {
  
  pdf(pdf_file, width = 14, height = 14)
  
  for (out in outcomes) {
    
    cat("✔ Generating Plots:", label, "-", out, "\n")
    
    # 1. Fit MMRM model
    f <- as.formula(paste0(out, " ~ mTBI_CMV_PI * VISIT + us(VISIT | INJURYID)"))
    mod <- mmrm(
      formula = f,
      data = data,
      weights = data$weights,
      method = "Residual",
      vcov = "Empirical-Bias-Reduced")
    
    # Use model frame from the model
    model_df <- stats::model.frame(mod)
    
    # 2. EMM plots
    res_emm <- emmeans(mod, pairwise ~ mTBI_CMV_PI | VISIT,
                       adjust = "none")
    
    emm_df <- summary(res_emm$emmeans, infer = c(TRUE, TRUE)) %>%
      as.data.frame() %>%
      mutate(mTBI_CMV_PI = factor(mTBI_CMV_PI))
    
    pal <- setNames(
      c("#648FFF", "#785EF0", "#DC267F", "#FE6100")[seq_along(levels(emm_df$mTBI_CMV_PI))],
      levels(emm_df$mTBI_CMV_PI))
    
    p1 <- ggplot(emm_df, aes(VISIT, emmean, color = mTBI_CMV_PI, group = mTBI_CMV_PI)) +
      geom_line(position = position_dodge(0.2)) +
      geom_point(position = position_dodge(0.2)) +
      geom_errorbar(aes(ymin = lower.CL, ymax = upper.CL),
                    width = 0.1, position = position_dodge(0.2)) +
      scale_color_manual(values = pal) +
      labs(title = paste("EMM by group:", out),
           x = "VISIT", y = "Estimated mean (EMM)", color = "mTBI_CMV_PI") +
      theme_bw()
    
    # Contrast plot
    contr_df <- summary(res_emm$contrasts, infer = c(TRUE, TRUE), level = 0.95) %>%
      as.data.frame()
    
    p2 <- ggplot(contr_df, aes(x = VISIT, y = estimate)) +
      geom_hline(yintercept = 0, linetype = 2) +
      geom_pointrange(aes(ymin = lower.CL, ymax = upper.CL)) +
      facet_wrap(~ contrast) +
      labs(title = paste("Pairwise contrasts:", out),
           y = "Difference in EMM (95% CI)") +
      theme_bw()
    
    # 3. Residual diagnostics
    res_vals <- residuals(mod)
    fit_vals <- fitted(mod)
    std_res <- scale(res_vals)
    
    p3 <- ggplot(data.frame(res_vals), aes(x = res_vals)) +
      geom_histogram(fill = "lightblue", color = "white", bins = 30) +
      labs(title = "Histogram of Residuals") +
      theme_bw()
    
    p4 <- ggplot(data.frame(res_vals = res_vals), aes(sample = res_vals)) +
      stat_qq() + stat_qq_line(color = "red") +
      labs(title = "Q-Q Plot of Residuals") +
      theme_bw()
    
    p5 <- ggplot(data.frame(fit_vals, res_vals), aes(x = fit_vals, y = res_vals)) +
      geom_point() +
      geom_hline(yintercept = 0, linetype = 2, color = "red") +
      labs(title = "Residuals vs Fitted", x = "Fitted Values", y = "Residuals") +
      theme_bw()
    
    acf_obj <- acf(res_vals, plot = FALSE)
    acf_df <- with(acf_obj, data.frame(lag = lag, acf = acf))
    
    p6 <- ggplot(acf_df, aes(x = lag, y = acf)) +
      geom_bar(stat = "identity", fill = "lightgreen") +
      labs(title = "ACF of Residuals") +
      theme_bw()
    
    # --- 7. Outlier plot (|Z| > 4) ---
    outlier_df <- data.frame(
      idx = seq_along(std_res),
      std_res = as.numeric(std_res),
      is_outlier = abs(std_res) > 4)
    
    p7 <- ggplot(outlier_df, aes(x = idx, y = std_res)) +
      geom_segment(aes(xend = idx, yend = 0)) +
      geom_point(aes(color = is_outlier), size = 2) +
      scale_color_manual(values = c("FALSE" = "black", "TRUE" = "red"),
                         labels = c("FALSE" = "OK", "TRUE" = "Outlier"),
                         name = "Flagged") +
      geom_hline(yintercept = c(-4, 4), linetype = 2, color = "red") +
      labs(title = "Flagged Outliers (|Z| > 4)",
           x = "Observation",
           y = "Standardized Residual (Z-score)") +
      theme_bw()
    
    # --- 8. Outlier table + counts based on model data ---
    outlier_idx <- which(abs(std_res) > 4)
    outlier_ids <- model_df$INJURYID[outlier_idx]
    outlier_visit <- model_df$VISIT[outlier_idx]
    
    # Wide count table excluding NAs
    count_df <- model_df %>%
      dplyr::filter(!is.na(.data[[out]])) %>%
      dplyr::count(mTBI_CMV_PI, VISIT) %>%
      tidyr::pivot_wider(
        names_from = VISIT,
        values_from = n,
        values_fill = 0)
    
    # Add overall row
    if (ncol(count_df) > 1) {
      sums <- colSums(count_df[ , -1, drop = FALSE])
      count_df <- dplyr::add_row(count_df, !!!setNames(as.list(sums), names(count_df)[-1]), mTBI_CMV_PI = "Overall")
    } else {
      count_df <- dplyr::add_row(count_df, mTBI_CMV_PI = "Overall")
    }
    
    # Outlier table
    if (length(outlier_idx) == 0) {
      outlier_tbl <- textGrob("No outliers detected",
                              gp = gpar(fontsize = 10, fontface = "italic"))
    } else {
      outlier_tbl <- tableGrob(
        data.frame(
          INJURYID = outlier_ids,
          VISIT = outlier_visit,
          Zscore = round(std_res[outlier_idx], 4)
        ),
        rows = NULL,
        theme = ttheme_minimal(base_size = 7)
      )
    }
    
    # Count table
    count_tbl <- tableGrob(
      count_df,
      rows = NULL,
      theme = ttheme_minimal(base_size = 7))
    
    # Add subtitles
    outlier_block <- arrangeGrob(
      textGrob("Flagged Residual Outliers",
               gp = gpar(fontsize = 12, fontface = "bold")),
      outlier_tbl,
      ncol = 1,
      heights = c(0.2, 0.8))
    
    count_block <- arrangeGrob(
      textGrob("N per Group and Visit",
               gp = gpar(fontsize = 12, fontface = "bold")),
      count_tbl,
      ncol = 1,
      heights = c(0.2, 0.8))
    
    # Combine into final p8
    p8 <- arrangeGrob(
      arrangeGrob(outlier_block, count_block, ncol = 2))
    
    # 4. Arrange plots with bold top title
    top_title <- textGrob(
      paste(label, "Outcome:", out),
      gp = gpar(fontsize = 20, fontface = "bold"))
    
    grid.arrange(p1, p2, p3, p4, p5, p6, p7, p8, ncol = 2, top = top_title)
  }
  
  dev.off()
  cat("✔ All", label, "plots saved to", pdf_file, "\n")
}

