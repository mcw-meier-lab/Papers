# -------------------------------------------------------------------- #
# 8. IDENTIFY & REMOVE OUTLIERS BY GROUP X VISIT 4 SDs FROM CELL MEAN  #
# -------------------------------------------------------------------- #

### CREATE SENSITIVITY DATASET WITH PER-TIMEPOINT RAW-Z OUTLIERS (|Z| > 4) ###
### FUNCTION WILL LOOP THROUGH EACH OUTCOME, IDENTIFY CELLS WHERE |Z| > 4, ###
### THEN MAKE THAT CELL NA. OTHER VISITS FOR THAT INJURYID WILL BE KEPT    ###

create_sensitivity_dataset <- function(data, outcomes, z_thresh = 4) {
  
  sens_data <- data  # start with a copy of the dataset
  
  for (out in outcomes) {
    
    cat("✔ Processing outcome:", out, "\n")
    
    # ---------------------------
    # Step 1: Compute raw-score z by VISIT × GROUP
    # ---------------------------
    sens_data <- sens_data %>%
      dplyr::group_by(VISIT, mTBI_CMV_PI) %>%
      dplyr::mutate(
        z_score = as.numeric(scale(.data[[out]]))
      ) %>%
      dplyr::ungroup()
    # ---------------------------
    # Step 2: Flag outlier timepoints and set them to NA
    # ---------------------------
    flagged <- abs(sens_data$z_score) > z_thresh
    sens_data[[out]][flagged] <- NA
    # ---------------------------
    # Step 3: Report number of flagged values
    # ---------------------------
    n_flagged <- sum(flagged, na.rm = TRUE)
    if (n_flagged > 0) {
      cat("   → Flagged", n_flagged, "outlier values for", out, "\n")
    } else {
      cat("   → No outliers detected for", out, "\n")
    }
    # ---------------------------
    # Step 4: Clean up temporary column
    # ---------------------------
    sens_data <- dplyr::select(sens_data, -z_score)
  }
  return(sens_data)
}


